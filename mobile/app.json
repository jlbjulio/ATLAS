{
  "expo": {
    "name": "ATLAS Field",
    "slug": "atlas-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-bg.png",
      "resizeMode": "cover",
      "backgroundColor": "#0D1B24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atlas.field"
    },
    "android": {
      "package": "com.atlas.field",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F3F6FA"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "ATLAS usa el micrófono para dictar observaciones de campo."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ATLAS usa la cámara para capturar placas autorizadas."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-sqlite",
      "@qvac/sdk/expo-plugin",
      "expo-asset"
    ]
  }
}
