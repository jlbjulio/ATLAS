{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/performance-log.schema.json",
  "title": "ATLAS QVAC performance event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "hardware",
    "model",
    "quantization",
    "task",
    "prompt",
    "input_tokens",
    "output_tokens",
    "model_load_ms",
    "ttft_ms",
    "total_inference_ms",
    "tokens_per_second",
    "success"
  ],
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "hardware": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "quantization": { "type": "string", "minLength": 1 },
    "task": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string" },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "model_load_ms": { "type": "number", "minimum": 0 },
    "ttft_ms": { "type": "number", "minimum": 0 },
    "total_inference_ms": { "type": "number", "minimum": 0 },
    "tokens_per_second": { "type": "number", "minimum": 0 },
    "success": { "type": "boolean" },
    "error": { "type": ["string", "null"] }
  }
}
